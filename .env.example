# 开发环境 API 密钥配置模板

# 使用方法：

#   1. 复制此文件并重命名为 .env

#   2. 填入你的真实 API 密钥

#   3. .env 文件已加入 .gitignore，不会上传到 GitHub

#

# 注意：打包后的程序不读取 .env，用户通过设置界面配置密钥，写入 config/settings.json



# ========== 方式 A：旧版变量（仍兼容，自动映射到 models v2） ==========

# 对话（DeepSeek 等）

LLM_PROVIDER=deepseek

LLM_API_KEY=

LLM_BASE_URL=https://api.deepseek.com

LLM_MODEL=deepseek-chat



# 识图（可与对话不同厂商；填写后自动视为独立连接）

VISION_API_URL=https://api.siliconflow.cn/v1/chat/completions

VISION_API_KEY=

VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct



# ========== 方式 B：新版 MODELS_*（推荐，与设置界面一致） ==========

# --- 对话连接（connection id: default）---

# MODELS_VENDOR=deepseek

# MODELS_API_KEY=

# MODELS_BASE_URL=https://api.deepseek.com

# MODELS_CHAT_MODEL=deepseek-chat



# --- 识图连接（connection id: vision；与对话不同时填写下列项）---

# MODELS_VISION_VENDOR=siliconflow

# MODELS_VISION_API_KEY=

# MODELS_VISION_BASE_URL=https://api.siliconflow.cn/v1

# MODELS_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct



# 显式指定是否共用对话连接：true / false（可选；不填时若识图 Key/URL 与对话不同则自动独立）

# MODELS_SAME_CONNECTION_AS_CHAT=false



# 对话与识图共用同一 API 时，只需填上方对话四项 + MODELS_VISION_MODEL 即可：

# MODELS_VENDOR=siliconflow

# MODELS_API_KEY=sk-xxx

# MODELS_BASE_URL=https://api.siliconflow.cn/v1

# MODELS_CHAT_MODEL=你的对话模型

# MODELS_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

